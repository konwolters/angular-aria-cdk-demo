{
  "name": "angular-aria-cdk-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:full": "ng serve --proxy-config proxy.conf.json",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css}\" \"*.{json,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css}\" \"*.{json,js}\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "overrides": {
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@angular/aria": "^22.2.4",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@fontsource-variable/inter": "^5.3.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
